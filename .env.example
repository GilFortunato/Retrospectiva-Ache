# O acesso aos conteúdos não exige variáveis de ambiente.
# A retrospectiva não usa banco de dados nem autenticação de participantes.

# BI: arquivo XLSX/XLSM no Drive com acesso de leitura por link.
# Use o ID do mesmo arquivo; a leitura ocorre no servidor, sem login de visitantes.
BI_DRIVE_FILE_ID=
BI_DISABILITY_ROSTER=

# Opcional: senha exclusiva para a área administrativa.
ACHE_ADMIN_PASSWORD_HASH=
ACHE_ADMIN_SESSION_SECRET=

# Opcional: integrações administrativas próprias desta cópia.
# O diagnóstico automático permanece desativado, mesmo com chaves configuradas.
# Não reutilize as credenciais, os identificadores ou o ambiente do projeto original.
ACHE_REBRAND_MANUS_API_KEY=
ACHE_REBRAND_GEMINI_API_KEY=
ACHE_REBRAND_GEMINI_MODEL=gemini-2.5-flash
ACHE_VERCEL_API_TOKEN=
ACHE_VERCEL_PROJECT_ID=
ACHE_VERCEL_TEAM_ID=
